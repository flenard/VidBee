{
  "name": "vidbee",
  "version": "1.3.10",
  "description": "A modern Electron application for downloading videos and audios",
  "main": "./out/main/index.js",
  "author": "VidBee",
  "homepage": "https://github.com/nexmoe/vidbee",
  "scripts": {
    "check": "ultracite check && pnpm run check:i18n && pnpm run typecheck",
    "check:i18n": "node scripts/check-locales.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "prepare:native-deps": "node scripts/ensure-native-deps.mjs",
    "dev:update-notice": "node scripts/dev-update-notice.mjs",
    "start": "pnpm run prepare:native-deps && electron-vite preview",
    "dev": "pnpm run setup && pnpm run prepare:native-deps && node scripts/set-console-encoding.js && electron-vite dev",
    "build": "electron-vite build",
    "build:glitchtip": "pnpm run build && node scripts/upload-glitchtip-sourcemaps.mjs",
    "setup": "node scripts/setup-dev-binaries.js",
    "postinstall": "node scripts/postinstall.mjs",
    "build:unpack": "pnpm run setup && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run setup && node scripts/check-ytdlp.js win && pnpm run build && electron-builder --win",
    "build:mac": "pnpm run setup && node scripts/check-ytdlp.js mac && pnpm run build && electron-builder --mac --x64 --arm64",
    "build:linux": "pnpm run setup && node scripts/check-ytdlp.js linux && pnpm run build && electron-builder --linux",
    "release": "git checkout main && git pull && pnpm run check && bumpp",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/cli": "^3.8.0",
    "@sentry/electron": "^7.20.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vidbee/db": "workspace:*",
    "@vidbee/downloader-core": "workspace:*",
    "@vidbee/i18n": "workspace:*",
    "@vidbee/subscriptions-core": "workspace:*",
    "@vidbee/task-queue": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "electron-ipc-decorator": "^1.0.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.2",
    "jotai": "^3.0.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yt-dlp-wrap-plus": "^2.5.0",
    "zod": "^4.6.5"
  },
  "dependenciesMeta": {
    "@vidbee/downloader-core": {
      "injected": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify/json": "^2.2.533",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vidbee/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "bumpp": "^12.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0"
  }
}
